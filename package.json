{
  "name": "dsh-terminal-startup-bar",
  "version": "0.1.0",
  "description": "Terminal startup status bar for DeepSeek Harness (dsh): shows which plugin a boot is loading, for how long, and how far it has gotten.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "dsh-plugin",
    "startup",
    "spinner",
    "progress",
    "terminal"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fishOfOUC/dsh-terminal-startup-bar.git"
  }
}
